{
  "name": "seemore",
  "version": "1.5.1",
  "description": "Let AI write the Markdown. Let seemore show it better — zero config documentation framework.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arifszn/seemore.git"
  },
  "bin": {
    "seemore": "./dist/cli/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/app",
    "src/shared",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepack": "node -e \"for (const f of ['README.md','LICENSE']) require('fs').copyFileSync('../../'+f, f)\"",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint --deny-warnings src tests"
  },
  "keywords": [
    "markdown",
    "mdx",
    "docs",
    "documentation",
    "documentation-generator",
    "static-site-generator",
    "docs-generator",
    "ai",
    "ai-agents",
    "llm",
    "claude",
    "agent",
    "vite",
    "cli",
    "developer-tools"
  ],
  "dependencies": {
    "@mdx-js/mdx": "3.1.1",
    "@mdx-js/react": "3.1.1",
    "@mdx-js/rollup": "3.1.1",
    "@tailwindcss/vite": "4.3.3",
    "@terrastruct/d2": "0.1.33",
    "@types/estree-jsx": "^1.0.5",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@vitejs/plugin-react": "^6.1.1",
    "chokidar": "5.0.0",
    "fumadocs-core": "16.15.4",
    "fumadocs-ui": "16.15.4",
    "github-slugger": "^2.0.0",
    "gray-matter": "4.0.3",
    "jiti": "2.7.0",
    "lucide-react": "^1.38.0",
    "mdast-util-to-string": "^4.0.0",
    "mermaid": "11.17.2",
    "picocolors": "^1.1.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-medium-image-zoom": "5.4.9",
    "react-router": "8.3.1",
    "remark-frontmatter": "^5.0.0",
    "tailwindcss": "4.3.3",
    "tinyglobby": "^0.2.17",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vfile": "^6.0.3",
    "vite": "8.2.2",
    "zod": "4.5.4"
  },
  "packageManager": "pnpm@10.34.5",
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "cheerio": "1.2.0",
    "oxlint": "^1.80.0",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
